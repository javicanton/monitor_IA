# Copiar a ~/monitor_IA/.env.reco (NO versionar) y rellenar con los datos del .env de monitorIA.
# Las comillas son obligatorias: sin ellas, bash corta la URL en el & y search_path no se aplica
# (la conexión se quedaría en public).
# Si la contraseña tiene @, #, &, espacios o %, hay que codificarla en la URL (percent-encoding).
DATABASE_URL="postgresql://USUARIO:PASSWORD@HOST.rds.amazonaws.com:5432/monitor_ia?sslmode=require&options=-csearch_path%3Dreco"
# Misma cuenta, sin search_path, solo para CREATE SCHEMA. Las lecturas de public.messages
# también pueden ir por DATABASE_URL (el nombre public va calificado).
DATABASE_URL_ADMIN="postgresql://USUARIO:PASSWORD@HOST.rds.amazonaws.com:5432/monitor_ia?sslmode=require"
# Esquema esperado por las guardias. Para el ensayo desechable: reco_test. Para el corpus: reco.
RECO_SCHEMA=reco
SCRAPER_CHANNEL_DELAY=10
SCRAPER_PG_BATCH=250
# Sesión Telethon distinta de la del cron. El primer login (teléfono y código) es manual.
TELEGRAM_SESSION_PATH=~/.telethon/reco.session
RECO_VENTANA_INICIO=2024-09-01
RECO_VENTANA_FIN=2025-12-31
# Copia opcional al terminar una fase. Vacío = no sube nada.
RECO_S3_PREFIX=
LEXICO_VERSION=v0.1
