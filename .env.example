# Copiar a .env y editar (opcional en EC2 si los datos se cargan por URL pública de S3).
# En la instancia: cp .env.example .env

AWS_REGION=eu-north-1
S3_BUCKET=monitoria-data

# --- PostgreSQL (recomendado para millones de mensajes) ---
# Si está definido, la API lee mensajes desde SQL en lugar de Parquet/S3.
# RDS: postgresql://usuario:password@host.rds.amazonaws.com:5432/monitor_ia?sslmode=require
# DATABASE_URL=postgresql://monitoria:password@localhost:5432/monitor_ia

# Claves de dataset en S3 (solo sin DATABASE_URL: DuckDB + Parquet, fallback JSON)
# DATASTORE_S3_PARQUET_KEY=telegram_messages.parquet
# DATASTORE_S3_JSON_KEY=telegram_messages.json

# Scraper → PostgreSQL (scripts/run_scraper_postgres.sh)
# SCRAPER_DAYS=7
# SCRAPER_MAX_MESSAGES=500
# TELEGRAM_CHANNELS_S3_KEY=s3://monitoria-data/telegram_channels.csv
# TELEGRAM_SESSION_PATH=~/.telethon/monitorIA.session

# Solo si no usas el rol IAM de la instancia:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

JWT_SECRET_KEY=cambiar-en-produccion
SECRET_KEY=cambiar-en-produccion
